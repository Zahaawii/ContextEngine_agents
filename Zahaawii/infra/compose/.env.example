# GHCR image naming
GHCR_OWNER=<github_owner_lowercase>
GHCR_REPO=contextengine_agents

# Blog backend + DB
BLOG_DB_NAME=contextengine_agents_blog
BLOG_DB_USER=<db_user>
BLOG_DB_PASSWORD=<db_password>
BLOG_DB_ROOT_PASSWORD=<db_root_password>
BLOG_JWT_TOKEN=<jwt_signing_secret>
WEBSOCKET_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Shared API keys
GOOGLE_API_KEY=<google_api_key>
CHROMADB_API_KEY=<chromadb_api_key>
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# MCP -> Blog API base URL
BLOG_API_BASE_URL=https://example.com/api

# Optional timezone
TZ=Europe/Copenhagen
